# ============================================================================
# Meditation Center - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ============================================================================

# Database Configuration
DB_HOST=host
DB_PORT=db_port
DB_NAME=db_name
DB_USERNAME=your_user_name_here
DB_PASSWORD=your_secure_password_here

# JWT Security
JWT_SECRET=change-this-to-a-secure-256-bit-secret-key-in-production-environment
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
JWT_ISSUER=meditation-center

# Application Port (optional)
SERVER_PORT=server_port

# Active Profile
SPRING_PROFILES_ACTIVE=dev

# Cloudflare R2 Object Storage
# Enable/disable R2 integration (set to true in production)
R2_ENABLED=false
# Your Cloudflare account ID
R2_ACCOUNT_ID=your_account_id_here
# R2 access key ID (create from Cloudflare dashboard)
R2_ACCESS_KEY_ID=your_access_key_id_here
# R2 secret access key (keep this secret!)
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
# R2 endpoint (format: https://<account-id>.r2.cloudflarestorage.com)
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
# R2 public URL (optional, for public bucket access)
R2_PUBLIC_URL=https://your-custom-domain.com

# R2 Bucket Names (create these in Cloudflare R2 dashboard)
R2_EVENTS_BUCKET_NAME=meditation-center-events
R2_PROGRAMS_BUCKET_NAME=meditation-center-programs
R2_USERS_BUCKET_NAME=meditation-center-users
R2_CAMPAIGNS_BUCKET_NAME=meditation-center-campaigns

# Presigned URL Expiry Durations (default: 5 minutes)
R2_EVENTS_PRESIGNED_URL_EXPIRY=5m
R2_PROGRAMS_PRESIGNED_URL_EXPIRY=5m
R2_USERS_PRESIGNED_URL_EXPIRY=5m
R2_CAMPAIGNS_PRESIGNED_URL_EXPIRY=5m
