# .dockerignore - Excludes files from Docker build context
# This makes Docker builds faster and images smaller

# Build output directories
build/
target/
out/
bin/

# Gradle cache and wrapper
.gradle/
!gradle/wrapper/gradle-wrapper.jar

# jOOQ generated code
# With DDL Database approach, jOOQ code is generated during Docker build
# from Flyway SQL files, so no need to copy pre-generated code
src/jooq/

# IDE files
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git files
.git/
.gitignore
.gitattributes

# Documentation (not needed in container)
*.md
!README.md

# Environment files (security - never copy secrets!)
.env
.env.local
.env.production
*.pem
*.key

# Test files
src/test/

# Log files
*.log
logs/

# Temporary files
tmp/
temp/

# Docker files (no need to copy these into the image)
Dockerfile
docker-compose.yml
.dockerignore
