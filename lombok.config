# Lombok configuration for the project
# This ensures Lombok works consistently across all environments including Docker

# Add @Generated annotation to all Lombok-generated code
lombok.addLombokGeneratedAnnotation = true

# Add @SuppressFBWarnings to all Lombok-generated code
lombok.addSuppressWarnings = true

# Enable parameter names retention
lombok.anyConstructor.addConstructorProperties = true

# Ensure Lombok works with Java 24
config.stopBubbling = true
