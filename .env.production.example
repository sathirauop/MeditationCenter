# ============================================================================
# Meditation Center - Production Environment Variables
#
# IMPORTANT:
# 1. Copy this file to .env.production
# 2. Fill in ALL values with STRONG credentials
# 3. NEVER commit .env.production to Git
# 4. Generate secrets using: openssl rand -base64 32
#
# Author: Sathira Basnayake
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION (Amazon RDS)
# ============================================================================

# Database host (Amazon RDS endpoint)
# Get from: AWS Console → RDS → Databases → Your DB → Endpoint
# Example: meditation-db-prod.xxxxxxxxx.eu-north-1.rds.amazonaws.com
DB_HOST=meditation-db-prod.xxxxxxxxx.YOUR_REGION.rds.amazonaws.com

# Database port (default PostgreSQL port)
DB_PORT=5432

# Database name (set when creating RDS instance)
DB_NAME=meditation_db

# Database username (RDS master username)
# Default: postgres (or custom username you set when creating RDS)
DB_USERNAME=postgres

# Database password (RDS master password)
# CRITICAL: This is the password you set when creating RDS instance!
# If you forgot it, you can reset it in AWS Console → RDS → Modify
# MUST be strong: minimum 8 characters, include letters and numbers
DB_PASSWORD=YOUR_RDS_MASTER_PASSWORD_HERE

# ============================================================================
# JWT SECURITY CONFIGURATION
# ============================================================================

# JWT Secret Key
# CRITICAL: MUST be changed in production!
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_SECURE_256_BIT_SECRET_KEY_MINIMUM_64_CHARACTERS

# JWT Access Token Expiration (15 minutes = 900000 ms)
JWT_ACCESS_TOKEN_EXPIRATION=900000

# JWT Refresh Token Expiration (7 days = 604800000 ms)
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# JWT Issuer
# If no domain yet: use "meditation-api"
# When domain ready: use your domain
JWT_ISSUER=meditation-api

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Server Port (internal - NGINX proxies to this)
SERVER_PORT=8080

# Spring Active Profile
SPRING_PROFILES_ACTIVE=prod

# Application URL
# If no domain yet: use http://YOUR_ELASTIC_IP
# When domain ready: use https://yourdomain.com
APP_URL=http://YOUR_ELASTIC_IP

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed origins (comma-separated)
# If no domain yet: use IP address and localhost for development
# When domain ready: update to https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://YOUR_ELASTIC_IP,http://localhost:3000

# ============================================================================
# EMAIL CONFIGURATION (Optional - for user notifications)
# ============================================================================

# SMTP Host
SMTP_HOST=smtp.gmail.com

# SMTP Port
SMTP_PORT=587

# SMTP Username
SMTP_USERNAME=your-email@gmail.com

# SMTP Password or App Password
SMTP_PASSWORD=your-app-password

# Email From Address
EMAIL_FROM=noreply@meditation.example.com

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================

# Max file upload size (10MB)
MAX_FILE_SIZE=10485760

# Allowed file types
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level (INFO, WARN, ERROR, DEBUG)
LOG_LEVEL=INFO

# Log file path
LOG_FILE_PATH=/var/log/meditation-center

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Admin Email (receives security alerts)
ADMIN_EMAIL=admin@meditation.example.com

# Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Session Timeout (30 minutes = 1800 seconds)
SESSION_TIMEOUT=1800

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Backup schedule (cron format: daily at 2 AM)
BACKUP_CRON=0 2 * * *

# ============================================================================
# MONITORING CONFIGURATION
# ============================================================================

# Health check endpoint enabled
HEALTH_CHECK_ENABLED=true

# Metrics endpoint enabled
METRICS_ENABLED=true

# ============================================================================
# FLYWAY DATABASE MIGRATION CONFIGURATION
# ============================================================================

# Enable Flyway migrations (runs automatically on startup)
FLYWAY_ENABLED=true

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================
#
# Amazon RDS Setup:
# [ ] Created Amazon RDS PostgreSQL instance
# [ ] Configured RDS security group to allow EC2 access
# [ ] Noted RDS endpoint URL
# [ ] Noted RDS master password
#
# Environment Configuration:
# [ ] Updated DB_HOST with RDS endpoint URL
# [ ] Updated DB_PASSWORD with RDS master password
# [ ] Generated strong JWT_SECRET (64+ characters): openssl rand -base64 64
# [ ] Updated APP_URL with EC2 Elastic IP or domain
# [ ] Updated CORS_ALLOWED_ORIGINS with EC2 IP or domain
# [ ] Set JWT_ISSUER (use "meditation-api" for IP, domain for production)
#
# EC2 Configuration:
# [ ] Created /var/www/meditation-frontend directory
# [ ] Copied React build files to /var/www/meditation-frontend
# [ ] Set correct permissions (chown www-data:www-data)
#
# Security Verification:
# [ ] Confirmed .env.production is in .gitignore
# [ ] Verified RDS is NOT publicly accessible
# [ ] Verified only EC2 can connect to RDS (security group)
# [ ] Verified Spring Boot port 8080 is NOT exposed (only NGINX port 80)
# [ ] Backed up .env.production securely
#
# Optional but Recommended:
# [ ] Configured SMTP settings for email notifications
# [ ] Set ADMIN_EMAIL for security alerts
# [ ] Set up RDS automated backups (7 days retention)
# [ ] Enabled RDS CloudWatch monitoring
# [ ] Set up Let's Encrypt SSL when domain is ready
#
# ============================================================================
