# ============================================================================
# Meditation Center - Production Environment Variables
#
# IMPORTANT:
# 1. Copy this file to .env.production
# 2. Fill in ALL values with STRONG credentials
# 3. NEVER commit .env.production to Git
# 4. Generate secrets using: openssl rand -base64 32
#
# Author: Sathira Basnayake
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Database host (use service name 'postgres-db' for Docker)
DB_HOST=postgres-db

# Database port
DB_PORT=5432

# Database name
DB_NAME=meditation_db

# Database username
# IMPORTANT: Change from default!
DB_USERNAME=meditation_prod_user

# Database password
# IMPORTANT: Generate a strong password!
# Generate with: openssl rand -base64 32
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# ============================================================================
# JWT SECURITY CONFIGURATION
# ============================================================================

# JWT Secret Key
# CRITICAL: MUST be changed in production!
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_SECURE_256_BIT_SECRET_KEY_MINIMUM_64_CHARACTERS

# JWT Access Token Expiration (15 minutes = 900000 ms)
JWT_ACCESS_TOKEN_EXPIRATION=900000

# JWT Refresh Token Expiration (7 days = 604800000 ms)
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# JWT Issuer (your domain)
JWT_ISSUER=meditation.example.com

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Server Port (internal - NGINX proxies to this)
SERVER_PORT=8080

# Spring Active Profile
SPRING_PROFILES_ACTIVE=prod

# Application URL (your domain)
APP_URL=https://meditation.example.com

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Allowed origins (comma-separated)
# Add your frontend domain if separate
CORS_ALLOWED_ORIGINS=https://meditation.example.com,https://www.meditation.example.com

# ============================================================================
# EMAIL CONFIGURATION (Optional - for user notifications)
# ============================================================================

# SMTP Host
SMTP_HOST=smtp.gmail.com

# SMTP Port
SMTP_PORT=587

# SMTP Username
SMTP_USERNAME=your-email@gmail.com

# SMTP Password or App Password
SMTP_PASSWORD=your-app-password

# Email From Address
EMAIL_FROM=noreply@meditation.example.com

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================

# Max file upload size (10MB)
MAX_FILE_SIZE=10485760

# Allowed file types
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================

# Log level (INFO, WARN, ERROR, DEBUG)
LOG_LEVEL=INFO

# Log file path
LOG_FILE_PATH=/var/log/meditation-center

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Admin Email (receives security alerts)
ADMIN_EMAIL=admin@meditation.example.com

# Rate Limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Session Timeout (30 minutes = 1800 seconds)
SESSION_TIMEOUT=1800

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Backup schedule (cron format: daily at 2 AM)
BACKUP_CRON=0 2 * * *

# ============================================================================
# MONITORING CONFIGURATION
# ============================================================================

# Health check endpoint enabled
HEALTH_CHECK_ENABLED=true

# Metrics endpoint enabled
METRICS_ENABLED=true

# ============================================================================
# PRODUCTION SECURITY CHECKLIST
# ============================================================================
#
# [ ] Changed DB_PASSWORD to strong password
# [ ] Changed JWT_SECRET to secure 64+ character string
# [ ] Updated JWT_ISSUER to your domain
# [ ] Updated APP_URL to your domain
# [ ] Updated CORS_ALLOWED_ORIGINS
# [ ] Configured SMTP settings
# [ ] Set ADMIN_EMAIL for alerts
# [ ] Verified all passwords are NOT default values
# [ ] Confirmed .env.production is in .gitignore
# [ ] Backed up .env.production securely
#
# ============================================================================
