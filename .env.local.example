# ============================================================================
# Meditation Center - Local Production Testing Environment
#
# Purpose: Test the full production stack (NGINX + App + DB) on local machine
#
# Setup:
# 1. Copy this file: cp .env.local.example .env.local
# 2. You can use the default values for local testing
# 3. Run: docker-compose -f docker-compose.local.yml up -d --build
# 4. Access: http://localhost
#
# Author: Sathira Basnayake
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

DB_HOST=postgres-db
DB_PORT=5432
DB_NAME=meditation_db
DB_USERNAME=local_user
DB_PASSWORD=local_password

# ============================================================================
# JWT SECURITY CONFIGURATION
# ============================================================================

# For local testing, you can use a simple secret
# In production, this MUST be a strong 64+ character secret
JWT_SECRET=local-testing-secret-key-not-for-production-use-only
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000
JWT_ISSUER=localhost

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_URL=http://localhost

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:8080

# ============================================================================
# NOTE: Local Testing vs Production
# ============================================================================
#
# Local Testing (this file):
# - Uses simple passwords (OK for local testing)
# - HTTP only (no SSL)
# - Access at: http://localhost
#
# Production (.env.production):
# - MUST use strong passwords
# - HTTPS with SSL certificates
# - Access at: https://yourdomain.com
#
# ============================================================================
